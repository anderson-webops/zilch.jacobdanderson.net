{
  "version": 2,
  "application": "anderson-webops/zilch.jacobdanderson.net",
  "adapter": {
    "name": "zilch-direct",
    "minimumContractVersion": 1,
    "requiredCapabilities": [
      "verified-tagged-artifact-v2",
      "protected-versioned-helpers",
      "candidate-runtime-acceptance",
      "atomic-service-and-nginx-promotion",
      "retained-artifact-rollback"
    ]
  },
  "probes": {
    "liveness": {
      "method": "GET",
      "path": "/healthz"
    },
    "readiness": {
      "method": "GET",
      "path": "/readyz"
    }
  },
  "database": {
    "migrations": "none",
    "rollbackCompatibility": "Retain the prior verified artifact and its versioned Nginx policy; no database state exists."
  },
  "entrypoints": [
    "back-end/dist/server.js"
  ],
  "required": [
    "package.json",
    "package-lock.json",
    "back-end/package.json",
    "back-end/package-lock.json",
    "front-end/package.json",
    ".zilch-release-prepared.json",
    "back-end/dist/server.js",
    "back-end/dist/runtime-version.js",
    "back-end/dist/app.js",
    "back-end/dist/server-config.js",
    "back-end/dist/boundedRateStore.js",
    "back-end/node_modules/cookie/compat.cjs",
    "back-end/node_modules/cookie/dist/index.js",
    "back-end/node_modules/encodeurl/compat.cjs",
    "back-end/node_modules/encodeurl/dist/index.js",
    "back-end/node_modules/raw-body/compat.cjs",
    "back-end/node_modules/raw-body/dist/index.js",
    "back-end/node_modules/type-is/compat.cjs",
    "back-end/node_modules/type-is/dist/index.js",
    "back-end/node_modules/iconv-lite/lib/index.js",
    "back-end/node_modules/mime-types/index.js",
    "front-end/.output/public/index.html",
    "front-end/.output/public/200.html",
    "front-end/.output/public/404.html",
    "front-end/.output/public/release.json"
  ],
  "runtime": {
    "os": "linux",
    "arch": "arm64",
    "node": "26.13.1",
    "npmBuildOnly": "12.2.2",
    "npmBuildProfile": "webops-locked-npm-v1",
    "npmBuildLockSha256": "87f602703478c129d228479cd4638f46e36057fd9299d214090057ca75d74bde",
    "npmBuildPayloadSha256": "266bb8045b5fd0c689010b9b1b1ec44a489147607836dc583243087e23fcc7b8"
  },
  "modulesOutsideDist": [],
  "generatedClients": [],
  "nativeBindings": [],
  "staticAssets": [
    "front-end/.output/public"
  ],
  "dependencyRoots": [
    "back-end"
  ],
  "writableState": [
    {
      "name": "logs",
      "location": "existing service journal",
      "rollback": "preserve journal; no application filesystem state or migrations"
    }
  ],
  "privateConfiguration": "Protected host environment stays external. Zilch has no database, provider credentials, queue, server-side player state, or durable local runtime state.",
  "topology": "Static Nuxt output with an independent compiled Express probe API. Preserve zilch-site, /srv/zilch.jacobdanderson.net, 127.0.0.1:3018, IPv4/IPv6 edge policy, and NP Service Request on 127.0.0.1:3016. The artifact does not replace the separate Netlify adapter."
}
