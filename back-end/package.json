{
	"name": "zilch-back-end",
	"version": "1.4.16",
	"private": true,
	"description": "Minimal read-only health API for the Zilch browser game.",
	"type": "module",
	"packageManager": "npm@12.2.1",
	"engines": {
		"node": ">=26.13.0 <27",
		"npm": ">=12.2.1 <13"
	},
	"main": "dist/server.js",
	"scripts": {
		"server": "tsx watch -r dotenv/config src/server.ts",
		"server:once": "tsx -r dotenv/config src/server.ts",
		"start": "node dist/server.js",
		"build": "tsc -p tsconfig.json",
		"watch": "tsc -w",
		"dev": "tsx watch -r dotenv/config src/server.ts",
		"typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
		"test": "vitest run",
		"lint": "eslint \"{src,test}/**/*.{js,ts}\"",
		"lint-fix": "eslint \"{src,test}/**/*.{js,ts}\" --fix"
	},
	"keywords": [
		"zilch",
		"express",
		"health-check"
	],
	"author": "Jacob Anderson",
	"license": "MIT",
	"dependencies": {
		"dotenv": "^18.0.9",
		"express": "^5.3.0",
		"express-rate-limit": "^8.7.2",
		"helmet": "^8.3.0",
		"qs": "file:vendor/qs-6.17.2-webops.1.tgz"
	},
	"devDependencies": {
		"@types/express": "^5.0.6",
		"@types/node": "^26.0.0",
		"@types/supertest": "^7.2.1",
		"globals": "^17.13.0",
		"supertest": "^7.3.1",
		"tsx": "^4.23.15",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	},
	"overrides": {
		"nanoid@^3": "3.3.18",
		"qs": "$qs"
	}
}
